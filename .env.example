# ─── Front-end (expostas no bundle — só chaves PÚBLICAS) ───────────────
# Sem estas duas variáveis o app roda em "modo demonstração" (localStorage).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ─── Servidor (Vercel Functions — NUNCA prefixe com VITE_) ─────────────
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # usado só em /api/admin-invite

OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5   # qualquer slug do OpenRouter
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini   # opcional
APP_URL=http://localhost:5173                  # usado no header HTTP-Referer do OpenRouter e no link de convite

# Apenas para desenvolvimento local sem Supabase: libera /api/llm sem login.
LLM_ALLOW_ANONYMOUS=false
